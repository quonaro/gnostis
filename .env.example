# Gnostis configuration — copy to `.env` and fill in your values.
# All variables are optional; defaults are shown in comments.
# Paths support ${VAR}, ${VAR:-default}, and ~ expansion.

# --- General -------------------------------------------------------------------

# Log verbosity: debug | info | warn | error   (default: info)
GS_LOG_LEVEL=info

# Directory for the SQLite database, memory notes, and other data.
# Supports ~ and ${HOME} interpolation.   (default: ~/.gnostis/data)
# GS_DATA_DIR=${HOME}/.gnostis/data

# --- Embeddings (OpenAI-compatible /embeddings endpoint) ------------------------

# Base URL of the embeddings API (must include /v1 for OpenAI-compatible APIs).
#   (default: http://localhost:7997/v1)
# GS_EMBEDDINGS_URL=http://localhost:7997/v1

# Embedding model name served by the endpoint.
#   (default: BAAI/bge-small-en-v1.5)
# GS_EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# API key for the embeddings endpoint. Leave empty for local servers
# that don't require authentication.
GS_EMBEDDINGS_API_KEY=

# Number of texts sent per embedding request.
#   (default: 32)
# GS_EMBEDDINGS_BATCH_SIZE=32

# Maximum characters of a chunk sent for embedding; longer chunks are truncated.
#   (default: 8000)
# GS_EMBEDDINGS_MAX_CHARS=8000

# --- Indexing ------------------------------------------------------------------

# Number of parallel workers used for chunking/parsing files during indexing.
#   (default: number of CPU cores; set lower to reduce CPU load)
# GS_INDEX_WORKERS=4

# --- HTTP MCP endpoint ----------------------------------------------------------

# Port for the HTTP server exposing the MCP endpoint (/mcp).
#   (default: 7878)
# GS_WEB_PORT=7878
